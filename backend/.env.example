DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/MovAI
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM for story analysis: "mock" (offline, crude) or "openai_compat"
LLM_PROVIDER=mock

# For openai_compat, any OpenAI-style endpoint. Example: Gemini free tier
# (get a key at https://aistudio.google.com; check current model names and limits).
# Free tiers may use prompts for training: test stories only.
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=<model name, for example a flash-lite model>
# LLM_API_KEY=<your key>
# LLM_FALLBACK_MODELS=<comma-separated models to try if the main one keeps failing>
# Optional second provider for the filler judge, so two different models must agree before a beat is cut.
# Blank values fall back to the LLM_* settings above.
# JUDGE_LLM_BASE_URL=
# JUDGE_LLM_MODEL=
# JUDGE_LLM_API_KEY=
# LLM_MIN_INTERVAL_SECONDS=6    # spacing between calls to stay under rate limits
# LLM_MAX_TOKENS=16384          # reply limit per call
# LLM_MAX_CALLS_PER_RUN=150     # stop a run after this many new calls
# ANALYSIS_BATCH_WORDS=6000     # words of story text per extraction call

# Origins of the separate UI app allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
