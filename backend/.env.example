DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/MovAI
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM for story analysis: "mock" (offline, crude) or "openai_compat"
LLM_PROVIDER=mock

# For openai_compat, any OpenAI-style endpoint. Example: Gemini free tier
# (get a key at https://aistudio.google.com; check current model names and limits).
# Free tiers may use prompts for training: test stories only.
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=<model name, for example a flash-lite model>
# LLM_API_KEY=<your key>
# LLM_FALLBACK_MODELS=<comma-separated models to try if the main one keeps failing>
# Optional second provider for the filler judge, so two different models must agree before a beat is cut.
# Blank values fall back to the LLM_* settings above.
# JUDGE_LLM_BASE_URL=
# JUDGE_LLM_MODEL=
# JUDGE_LLM_API_KEY=
# LLM_MIN_INTERVAL_SECONDS=6    # spacing between calls to stay under rate limits
# LLM_MAX_TOKENS=16384          # reply limit per call
# LLM_MAX_CALLS_PER_RUN=150     # stop a run after this many new calls
# ANALYSIS_BATCH_WORDS=6000     # words of story text per extraction call

# ---- Media generation (images, keyframes, sound, clips, renders) ----
# Every provider is "mock" (placeholder files, no cost) until a real one is added. A provider that cannot answer
# at once (a manual/sandbox adapter) leaves the request "awaiting_input"; the result is uploaded through
# POST /api/v1/generation-requests/{id}/result.
# IMAGE_PROVIDER=mock
# VIDEO_PROVIDER=mock
# VOICE_PROVIDER=mock
# MUSIC_PROVIDER=mock
# STORAGE_DIR=storage           # generated and uploaded files; relative to the backend folder. Run the API and the
#                               # job runner from the same checkout so they agree on this folder.
# FFMPEG_PATH=                  # ffmpeg executable or its folder; blank = PATH, then the winget install location
# FFMPEG_TIMEOUT_SECONDS=600
# MEDIA_VIDEO_WIDTH=1280        # the common profile every clip is normalized to before stitching
# MEDIA_VIDEO_HEIGHT=720
# MEDIA_VIDEO_FPS=24
# MEDIA_VIDEO_CRF=20
# RENDER_WORKING_WIDTH=640      # low-res working size for clips, animatic and draft renders
# RENDER_WORKING_HEIGHT=360
# RENDER_WORKING_FPS=24
# RENDER_WORKING_CRF=28
# FINAL_EXPORT_HEIGHT=1080      # the final export is upscaled to this height
# CLIP_DURATION_TOLERANCE=0.15  # seconds a clip may differ from its shot before it counts as short or long
# CONSISTENCY_JUDGE=mock        # drift check: mock (colour only), llm_vision (needs a model that reads images), none
# CONSISTENCY_THRESHOLD=0.7     # a match score below this is flagged as drift

# Origins of the separate UI app allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
